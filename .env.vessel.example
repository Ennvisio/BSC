# NaviSuite - VESSEL onboard server (Windows master PC).
# deploy/windows/install-server.ps1 writes .env from this file and fills in
# the keys, passwords and addresses itself. To set a server up by hand, copy
# it to .env and fill in the blanks.
# Check the result with:  php artisan navisuite:status

APP_NAME=NaviSuite
APP_ENV=production
# Credentials (APP_KEY, SYNC_NODE_TOKEN, VESSEL_DB_PASSWORD, APP_HEALTH_TOKEN)
# are not kept here on a vessel server (Checkpoint 7): install-server.ps1
# stores them encrypted with Windows DPAPI in C:\NaviSuite\secrets\app and
# leaves these lines empty. To change one later:
#   artisan.cmd navisuite:secrets set sync_node_token
# A value typed here still works, and wins only while no secret is stored;
# "navisuite:status" warns about it.
NAVISUITE_SECRETS_PATH=
NAVISUITE_SECRETS_PROTECTOR=dpapi
APP_KEY=
# Never turn debug on: every PC on the ship's LAN would see error details.
APP_DEBUG=false
# The address crew PCs use to reach this server on the LAN. The installer
# sets it to https://<computer name>.
APP_URL=https://navisuite-server
# The build this server runs. Set by the install and update scripts.
APP_RELEASE=

# Deployment mode. "vessel" limits sign-in to this vessel's crew and makes
# office-maintained data read-only. See config/navisuite.php.
APP_MODE=vessel
# This vessel's id in the CLOUD database (vessels.id). Required.
APP_VESSEL_ID=
# Optional: comma-separated e-mails of shore accounts allowed to sign in
# here for support. They are read-only on board.
APP_SUPPORT_ACCOUNTS=

# Sync identity. On the CLOUD run:
#   php artisan sync:register-node vessel --vessel=<APP_VESSEL_ID> --name="<PC name>"
# and give the two values it prints to install-server.ps1 (-SyncNodeId,
# -SyncNodeToken), which stores the token encrypted. Shown only once.
SYNC_NODE_ID=
SYNC_NODE_TOKEN=
# The cloud's https:// address. Empty: the NaviSuite-Sync service stays idle.
SYNC_CLOUD_URL=
# Tables to synchronise (each needs a rule in config/sync.php "replication").
# Must list the same tables as the cloud's SYNC_TABLES.
# Business modules (docs/checkpoint-6-business-sync.md), only after the
# vessel's initial copy exists:
#   SYNC_TABLES=currencies,ranks,categories,@master,@inventory,@pms,@requisitions
SYNC_TABLES=currencies,ranks,categories
# Seconds between sync cycles while all is well.
SYNC_INTERVAL=300
# Optional: a CA bundle file for the cloud's certificate, instead of the one
# in php.ini (curl.cainfo), e.g. for a private CA.
SYNC_CA_BUNDLE=

LOG_CHANNEL=daily

# The onboard MySQL server. It must listen on 127.0.0.1 only.
DB_CONNECTION=vessel
VESSEL_DB_HOST=127.0.0.1
VESSEL_DB_PORT=3306
VESSEL_DB_DATABASE=navisuite
VESSEL_DB_USERNAME=navisuite
VESSEL_DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
SESSION_DRIVER=file
SESSION_LIFETIME=120
# The LAN uses HTTPS with the server's own certificate.
SESSION_SECURE_COOKIE=true
# Background jobs run in the NaviSuite-Queue Windows service.
QUEUE_CONNECTION=database

# No internet on board: mail is written to the log instead of being sent.
MAIL_DRIVER=log
MAIL_FROM_ADDRESS=noreply@navisuite.local
MAIL_FROM_NAME="${APP_NAME}"

# GET /health. On by default in vessel mode. Anyone on the LAN sees the
# overall status; the individual checks are shown only to this PC itself,
# to the addresses below, or to a caller sending X-Health-Token.
APP_HEALTH_TOKEN=
# Comma-separated IPs or CIDR ranges, e.g. 192.168.10.5,10.0.0.0/24
APP_HEALTH_DETAIL_IPS=

# LAN discovery (NaviSuite-Discovery service, UDP 47810): desktop clients
# find this server by broadcast. On by default in vessel mode.
# APP_DISCOVERY_ENABLED=false
# APP_DISCOVERY_PORT=47810
# The vessel's public CA certificate; discovery announces its fingerprint.
# The installer sets it to C:\NaviSuite\config\certs\ca.crt.
APP_TLS_CA_FILE=
