<?xml version="1.0" encoding="utf-8"?>
<!--
  NaviSuite LAN discovery responder, run as a Windows service by WinSW 2.12.
  Generated by deploy/windows/install-server.ps1 from
  deploy/windows/templates/NaviSuite-Discovery.xml.

  Answers the desktop clients' UDP question on port 47810 with this
  server's vessel, host name and certificate fingerprint. It only reads.
  See docs/checkpoint-4-desktop-client.md.
-->
<service>
  <id>NaviSuite-Discovery</id>
  <name>NaviSuite Discovery</name>
  <description>Lets NaviSuite desktop clients find this server on the LAN (UDP 47810).</description>
  <executable>{{ROOT}}\runtime\php\php.exe</executable>
  <arguments>"{{ROOT}}\app\artisan" navisuite:discovery</arguments>
  <workingdirectory>{{ROOT}}\app</workingdirectory>
  <env name="PHPRC" value="{{ROOT}}\config\php"/>
  <startmode>Automatic</startmode>
  <delayedAutoStart>true</delayedAutoStart>
  <onfailure action="restart" delay="10 sec"/>
  <onfailure action="restart" delay="30 sec"/>
  <onfailure action="restart" delay="60 sec"/>
  <resetfailure>1 hour</resetfailure>
  <stoptimeout>10 sec</stoptimeout>
  <logpath>{{ROOT}}\data\logs\discovery</logpath>
  <log mode="roll-by-size">
    <sizeThreshold>10240</sizeThreshold>
    <keepFiles>3</keepFiles>
  </log>
</service>
