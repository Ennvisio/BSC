<?xml version="1.0" encoding="utf-8"?>
<!--
  NaviSuite queue worker, run as a Windows service by WinSW 2.12.
  Generated by deploy/windows/install-server.ps1 from
  deploy/windows/templates/NaviSuite-Queue.xml.

  Do not add the max-time or max-jobs options, and never run "php artisan
  queue:restart" on this server: each makes the worker exit with code 0,
  which Windows treats as a normal stop and does not restart. When the
  worker reaches its memory limit it exits with code 12 and is restarted.
-->
<service>
  <id>NaviSuite-Queue</id>
  <name>NaviSuite Queue Worker</name>
  <description>Runs NaviSuite background jobs (Laravel queue worker on the database queue).</description>
  <executable>{{ROOT}}\runtime\php\php.exe</executable>
  <arguments>"{{ROOT}}\app\artisan" queue:work database --sleep=3 --tries=3 --timeout=120 --memory=256</arguments>
  <workingdirectory>{{ROOT}}\app</workingdirectory>
  <env name="PHPRC" value="{{ROOT}}\config\php"/>
  <depend>NaviSuite-MySQL</depend>
  <startmode>Automatic</startmode>
  <delayedAutoStart>true</delayedAutoStart>
  <onfailure action="restart" delay="10 sec"/>
  <onfailure action="restart" delay="30 sec"/>
  <onfailure action="restart" delay="60 sec"/>
  <resetfailure>1 hour</resetfailure>
  <stoptimeout>30 sec</stoptimeout>
  <logpath>{{ROOT}}\data\logs\queue</logpath>
  <log mode="roll-by-size">
    <sizeThreshold>10240</sizeThreshold>
    <keepFiles>5</keepFiles>
  </log>
</service>
