<?xml version="1.0" encoding="utf-8"?>
<!--
  NaviSuite sync with the cloud, run as a Windows service by WinSW 2.12.
  Generated by deploy/windows/install-server.ps1 from
  deploy/windows/templates/NaviSuite-Sync.xml.

  sync:work checks every few seconds whether a cycle is due. It sends the
  vessel's changes and fetches the cloud's when the internet is there, and
  waits longer after each failure (30 s doubling up to 30 minutes) when it
  is not. The schedule is kept in the database, so a restart or a reboot
  carries on where it stopped. Stopping it in the middle of a cycle is safe:
  every step is a database transaction, and an unanswered batch is sent
  again unchanged.

  While SYNC_CLOUD_URL is empty in .env the service only reports that it is
  alive.
-->
<service>
  <id>NaviSuite-Sync</id>
  <name>NaviSuite Sync</name>
  <description>Synchronises this vessel's NaviSuite data with the cloud when the internet is available.</description>
  <executable>{{ROOT}}\runtime\php\php.exe</executable>
  <arguments>"{{ROOT}}\app\artisan" sync:work</arguments>
  <workingdirectory>{{ROOT}}\app</workingdirectory>
  <env name="PHPRC" value="{{ROOT}}\config\php"/>
  <depend>NaviSuite-MySQL</depend>
  <startmode>Automatic</startmode>
  <delayedAutoStart>true</delayedAutoStart>
  <onfailure action="restart" delay="10 sec"/>
  <onfailure action="restart" delay="30 sec"/>
  <onfailure action="restart" delay="60 sec"/>
  <resetfailure>1 hour</resetfailure>
  <stoptimeout>30 sec</stoptimeout>
  <logpath>{{ROOT}}\data\logs\sync</logpath>
  <log mode="roll-by-size">
    <sizeThreshold>10240</sizeThreshold>
    <keepFiles>5</keepFiles>
  </log>
</service>
