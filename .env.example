# NaviSuite - CLOUD server (shore). Copy to .env and fill in the blanks.
# A vessel's onboard server uses .env.vessel.example instead.

APP_NAME=NaviSuite
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://navisuite.example.com

# Deployment mode: cloud (default) or vessel. See config/navisuite.php.
APP_MODE=cloud
# When "true", ship crew of a vessel marked with
# `php artisan navisuite:vessel-offline {id}` can only view data here.
APP_LOCK_OFFLINE_VESSELS=true

# Sync identity of this cloud server (a UUID from
# `php artisan sync:register-node cloud`). Vessel nodes are registered here too.
SYNC_NODE_ID=
# Tables synchronised with the vessels (each needs a rule in config/sync.php
# "replication"). Every vessel's .env must list the same tables.
# Business modules: currencies,ranks,categories,@master,@inventory,@pms,@requisitions
# (docs/checkpoint-6-business-sync.md). Same value on every vessel.
SYNC_TABLES=currencies,ranks,categories
# When a vessel's stock movement does not add up here: adopt or keep.
SYNC_STOCK_ON_MISMATCH=adopt

LOG_CHANNEL=stack

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
SESSION_DRIVER=file
SESSION_LIFETIME=120
QUEUE_CONNECTION=sync

MAIL_DRIVER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# GET /health is off on the cloud (404) unless switched on here.
# APP_HEALTH_ENABLED=true
# APP_HEALTH_TOKEN=

# Checkpoint 7: credentials can be kept encrypted instead of in this file
# (php artisan navisuite:secrets import-env moves them). Folder of the
# encrypted files (default storage/app/secrets) and how they are protected:
# auto = Windows DPAPI where available, otherwise a libsodium key file.
NAVISUITE_SECRETS_PATH=
NAVISUITE_SECRETS_PROTECTOR=auto
# Deactivated users cannot sign in (set false only to restore the old behaviour).
APP_BLOCK_DEACTIVATED_USERS=true
# Files of synchronised records (attachments, signatures, certificate copies).
SYNC_FILES=true
SYNC_OFFLINE_WARNING_HOURS=72
